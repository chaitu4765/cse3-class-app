{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "frontend/dist"
            }
        }
    ],
    "outputDirectory": "frontend/dist",
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}